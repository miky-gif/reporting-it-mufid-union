# === Configuration de production — MUFID UNION (Docker Compose) ===
# Copiez ce fichier en « .env » à la racine du dépôt, puis complétez CHAQUE
# valeur. Ce fichier NE DOIT JAMAIS être commité ni partagé (secrets réels).
#
#   cp .env.production.example .env

# ------------------------------------------------------------------
# Nom de domaine (DNS déjà pointé vers l'IP de ce serveur)
# ------------------------------------------------------------------
DOMAIN=mufid.votre-domaine.cm

# Origines autorisées à appeler l'API (le frontend est servi par le même
# domaine : une seule valeur suffit en général, HTTPS obligatoire)
CORS_ORIGINS=https://mufid.votre-domaine.cm

# ------------------------------------------------------------------
# Base de données (MariaDB) — choisissez deux mots de passe FORTS et distincts
# ------------------------------------------------------------------
DB_NAME=mufid_activites
DB_USER=mufid_app
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_applicatif
DB_ROOT_PASSWORD=CHANGEZ_MOI_mot_de_passe_root_mariadb

# ------------------------------------------------------------------
# Sécurité JWT — générez une valeur aléatoire, par exemple :
#   openssl rand -base64 48
# ------------------------------------------------------------------
JWT_SECRET=CHANGEZ_MOI_avec_une_cle_aleatoire_longue
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Mot de passe attribué aux comptes créés par `npm run seed` (données de
# démonstration — normalement inutilisé en production, voir le manuel).
SEED_PASSWORD=

# ------------------------------------------------------------------
# Pièces jointes — laissez vide pour un stockage local (volume Docker
# `uploads_data`, persistant). Pour le NAS de l'entreprise, voir la section
# dédiée de DEPLOIEMENT-DOCKER.md (montage CIFS sur l'hôte, puis chemin ici).
# ------------------------------------------------------------------
UPLOADS_DIR=

# ------------------------------------------------------------------
# E-mail (optionnel) — laissez SMTP_HOST vide pour désactiver l'envoi réel
# (les notifications restent visibles dans la plateforme, sans e-mail).
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MUFID UNION <no-reply@votre-domaine.cm>
